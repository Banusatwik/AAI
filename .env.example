# Database Configuration (PostgreSQL for Docker, SQLite for standalone local testing)
DATABASE_URL=postgresql://mech_user:mech_password@localhost:5432/mechanical_safety_db
# For standalone local development without Docker:
# DATABASE_URL=sqlite:///./mechanical_safety.db

# AI / LLM Configuration (Optional: deterministic fallback runs with 100% functionality without API key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Risk and Probability Engine Thresholds
MIN_SAMPLE_SIZE_FOR_PROBABILITY=10
CRITICAL_RISK_THRESHOLD=75.0
HIGH_RISK_THRESHOLD=50.0
MODERATE_RISK_THRESHOLD=25.0
